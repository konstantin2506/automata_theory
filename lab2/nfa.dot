digraph NFA {
    rankdir=LR;
    node [shape=circle];
    start [shape=point];
    0 [label="0"];
    1 [label="1"];
    2 [label="2"];
    3 [label="3", shape=doublecircle];
    2 -> 3 [label="ε"];
    2 -> 1 [label="ε"];
    1 -> 2 [label="a"];
    0 -> 1 [label="ε"];
    0 -> 3 [label="ε"];
    start -> 0;
}
