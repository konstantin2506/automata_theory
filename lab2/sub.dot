digraph DFA {
    rankdir=LR;

    start [shape=none, label=""];

    0 [label="S0", shape=circle];
    1 [label="S1", shape=circle];
    2 [label="S2", shape=doublecircle];
    3 [label="S3", shape=doublecircle];

    start -> 0;

    0 -> 2 [label="a"];
    0 -> 1 [label="b"];
    1 -> 1 [label="a"];
    1 -> 1 [label="b"];
    2 -> 2 [label="a"];
    2 -> 3 [label="b"];
    3 -> 1 [label="a"];
    3 -> 3 [label="b"];
}
