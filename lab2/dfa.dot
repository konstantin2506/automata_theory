digraph DFA {
    rankdir=LR;

    start [shape=none, label=""];

    0 [label="S0", shape=doublecircle];
    1 [label="S1", shape=circle];
    2 [label="S2", shape=circle];
    3 [label="S3", shape=doublecircle];
    4 [label="S4", shape=doublecircle];

    start -> 0;

    0 -> 1 [label="q"];
    0 -> 2 [label="a"];
    1 -> 3 [label="w"];
    2 -> 4 [label="b"];
    4 -> 2 [label="a"];
}
