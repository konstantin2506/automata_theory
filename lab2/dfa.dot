digraph DFA {
  rankdir=LR;
  node [shape=circle];

  start [shape=point];
  start -> S0;

  S0 [label="S0\n"];
  S1 [label="S1\n"];
  S2 [label="S2\n"];
  S3 [label="S3\n"];
  S4 [label="S4\n", peripheries=2];

  S0 -> S1 [label="a"];
  S0 -> S2 [label="c"];
  S1 -> S1 [label="a"];
  S2 -> S3 [label="c"];
  S3 -> S4 [label="c"];
}
